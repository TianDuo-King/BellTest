<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/publish_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="72dp" android:layout_height="52dp"
        android:background="@drawable/publish_action_background" android:gravity="center"
        android:text="＋" android:textColor="#FF111214" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="发布" android:textColor="#FFFFFFFF"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center"
        android:text="module_publish\n拍摄、剪辑和上传在下一阶段接入"
        android:textColor="#99FFFFFF" android:textSize="15sp" />
</LinearLayout>
