<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="消息"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="互动、私信和系统通知"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/message_module_chain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FF25202C"
            android:gravity="center"
            android:padding="12dp"
            android:text="全部  4     互动  2     私信  1     系统  1"
            android:textColor="#FFFFC6EA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FF1B1D22"
            android:padding="18dp"
            android:text="小白同学                                      刚刚\n赞了你分享的「森林里的轻松一刻」\n\n● 1 条新互动"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FF1B1D22"
            android:padding="18dp"
            android:text="旅行收藏夹                                  10:24\n周末海岸线的完整路线已经整理好了，一起出发吗？"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FF1B1D22"
            android:padding="18dp"
            android:text="Media3 学习小组                         昨天\n下一条视频预取和磁盘缓存策略已更新"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FF1B1D22"
            android:padding="18dp"
            android:text="系统通知                                      周一\n你收藏的 8 部高清内容现在可以连续播放"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
