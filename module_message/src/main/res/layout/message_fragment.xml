<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="消息" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/message_module_chain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#FF25202C"
        android:padding="12dp"
        android:text="消息调用链\napp → module_message → lib_base / lib_resources"
        android:textColor="#FFFFC6EA"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:background="#FF1B1D22" android:padding="18dp"
        android:text="互动消息\n暂无新消息" android:textColor="#FFFFFFFF" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="#FF1B1D22" android:padding="18dp"
        android:text="系统通知\n多模块框架已就绪" android:textColor="#FFFFFFFF" android:textSize="16sp" />
</LinearLayout>
