<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/user_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FF1B1D22"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BT   BellTest"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Android 多模块与播放器实验账号"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="关注  128        粉丝  2.6w        获赞  18.9w"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FF172724"
            android:padding="16dp"
            android:text="视频缓存 · 512MB LRU\n播放内容优先从磁盘读取，下一条视频提前预取前 8MB"
            android:textColor="#FF9AF5E9"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="学习实验"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open_async_lab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="XTask / RxJava / 协程对比" />

        <Button
            android:id="@+id/open_rx_lab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RxJava Observer 实验" />

        <Button
            android:id="@+id/open_leak_lab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内存泄漏 / Heap Dump 实验" />

        <TextView
            android:id="@+id/user_module_chain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FF1B1D22"
            android:padding="16dp"
            android:text="开发者信息\nUI：多模块 + ViewBinding\n播放：Media3 + AIDL 独立进程\n缓存：磁盘 LRU + 下一条预取"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
