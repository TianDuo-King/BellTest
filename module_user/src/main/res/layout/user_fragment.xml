<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/user_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="我" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="BellTest · 多模块学习入口"
            android:textColor="#99FFFFFF" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="学习实验"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/open_async_lab" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="XTask / RxJava / 协程对比" />
        <Button android:id="@+id/open_rx_lab" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="RxJava Observer 实验" />
        <Button android:id="@+id/open_leak_lab" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="内存泄漏 / Heap Dump 实验" />
        <TextView android:id="@+id/user_module_chain"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:background="#FF1B1D22" android:padding="16dp"
            android:text="我的调用链\napp → module_user → module_lab\n学习模块：XTask / RxJava / 协程 / Profiler\n播放器进程：com.example.belltest:player"
            android:textColor="#CCFFFFFF" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
