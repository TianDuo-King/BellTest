<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RxJava Observer 实验室" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="01 / Observable + Observer"
            android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_start_single" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="开始单个订阅" />
        <Button android:id="@+id/btn_start_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="模拟 onError" />
        <Button android:id="@+id/btn_stop_single" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Disposable：取消单个订阅" />
        <TextView android:id="@+id/tv_single_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="8dp" android:text="单任务：未开始" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="02 / CompositeDisposable"
            android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_start_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="启动 3 个订阅任务" />
        <Button android:id="@+id/btn_clear_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="clear()：取消并清空订阅" />
        <Button android:id="@+id/btn_dispose_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="dispose()：终止容器" />
        <Button android:id="@+id/btn_reset_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="重建 CompositeDisposable" />
        <TextView android:id="@+id/tv_group_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="8dp" android:text="容器：未开始" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="03 / 实时日志"
            android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_clear_log" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="清空日志" />
        <TextView android:id="@+id/tv_log" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="#1D2430" android:padding="12dp" android:text="等待订阅...\n"
            android:textColor="#D9F6E4" android:textIsSelectable="true" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
